{
  "name": "chaos-control-room",
  "version": "0.0.0",
  "private": true,
  "description": "Interactive browser simulation of a Kubernetes platform under failure: chaos experiments, SLOs, burn-rate alerts, autoscaling, self-healing and database failover.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lhci": "npm ci --prefix tools/lighthouse --no-audit --no-fund && tools/lighthouse/node_modules/.bin/lhci autorun",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "gsap": "3.15.0",
    "three": "0.186.1"
  }
}
